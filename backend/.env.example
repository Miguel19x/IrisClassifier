# Database
DATABASE_URL=postgresql://user:password@localhost:5432/iris_db
# For development with SQLite:
# DATABASE_URL=sqlite:///./iris.db

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Ollama AI
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT=60
OLLAMA_MODEL=llama3.2
OLLAMA_MAX_RETRIES=2

# Gemini AI Vision (FREE: 1500 requests/day)
GEMINI_API_KEY=geminiasdasd
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_TIMEOUT=60

# Caching
CACHE_MAX_SIZE=2000
CACHE_TTL_SECONDS=3600

# Processing
BATCH_SIZE=20
MAX_FILE_SIZE_MB=100
MAX_PRODUCTS_PER_CATALOG=10000

# Security
SECRET_KEY=your-secret-key-here-change-in-production
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# Logging
LOG_LEVEL=INFO
JSON_LOGS=true

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8100,capacitor://localhost,http://localhost
