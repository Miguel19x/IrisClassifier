{
    "appId": "com.irisclassifier.app",
    "appName": "IrisClassifier",
    "webDir": "dist",
    "server": {
        "androidScheme": "https"
    },
    "plugins": {
        "CapacitorSQLite": {
            "iosDatabaseLocation": "Library/CapacitorDatabase",
            "iosIsEncryption": false,
            "androidIsEncryption": false,
            "androidBiometric": {
                "biometricAuth": false
            }
        },
        "Camera": {
            "permissions": [
                "camera",
                "photos"
            ]
        },
        "Filesystem": {
            "permissions": [
                "publicStorage"
            ]
        }
    }
}