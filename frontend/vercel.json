{
    "buildCommand": "pnpm build",
    "outputDirectory": "dist",
    "framework": "vite",
    "installCommand": "pnpm install",
    "env": {
        "VITE_API_URL": "https://irisclassifier-api.onrender.com",
        "VITE_MOCK_API": "true",
        "VITE_DEMO_MODE": "true"
    },
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}